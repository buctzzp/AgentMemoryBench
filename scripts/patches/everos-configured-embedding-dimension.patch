diff --git a/src/everos/infra/persistence/lancedb/tables/_embedding_dimension.py b/src/everos/infra/persistence/lancedb/tables/_embedding_dimension.py
new file mode 100644
index 0000000..867b573
--- /dev/null
+++ b/src/everos/infra/persistence/lancedb/tables/_embedding_dimension.py
@@ -0,0 +1,21 @@
+"""Resolve the configured LanceDB vector width at schema-import time."""
+
+from __future__ import annotations
+
+from everos.config import load_settings
+
+
+_DEFAULT_DIMENSION = 1024
+
+
+def configured_embedding_dimension() -> int:
+    """Return the embedding width shared by providers and LanceDB schemas."""
+
+    configured = load_settings().embedding.dimensions
+    dimension = _DEFAULT_DIMENSION if configured is None else configured
+    if type(dimension) is not int or dimension < 1:
+        raise ValueError("embedding dimensions must be a positive integer")
+    return dimension
+
+
+__all__ = ["configured_embedding_dimension"]
